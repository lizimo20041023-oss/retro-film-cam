{
  "name": "retro-film-cam",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "tunnel": "expo start --tunnel",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package",
    "deps": "expo install expo-camera expo-media-library expo-image-manipulator expo-haptics expo-font react-native-view-shot react-native-safe-area-context"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.27",
    "expo-camera": "~57.0.6",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-media-library": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-view-shot": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.14",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
