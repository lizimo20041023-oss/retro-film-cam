{
  "expo": {
    "name": "Retro Film Cam",
    "slug": "retro-film-cam",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "scheme": "retrofilmcam",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.canyerylee.retrofilmcam",
      "infoPlist": {
        "NSCameraUsageDescription": "需要使用相机来取景拍摄胶片风格照片。",
        "NSPhotoLibraryAddUsageDescription": "需要把显影后的成片保存到你的相册。"
      }
    },
    "android": {
      "package": "com.canyerylee.retrofilmcam",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "允许 $(PRODUCT_NAME) 使用相机取景拍摄。",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "允许 $(PRODUCT_NAME) 保存成片到相册。",
          "savePhotosPermission": "允许 $(PRODUCT_NAME) 把成片保存到相册。",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
