+  /// A short, moderately sensitive exposure keeps low-light shots from being
+  /// converted into day-bright multi-frame photographs. The preview stays on
+  /// automatic exposure; this temporary override exists only for the shutter.
+  private func prepareFilmExposure() async -> AVCaptureDevice? {
+    guard captureDelegate?.flashMode == .off,
+          captureDelegate?.presetCamera == .back,
+          let device = captureDelegate?.currentCaptureDevice,
+          device.isExposureModeSupported(.custom) else { return nil }
+    let currentSeconds = CMTimeGetSeconds(device.exposureDuration)
+    guard currentSeconds.isFinite, currentSeconds > 0 else { return nil }
+    let targetSeconds = max(CMTimeGetSeconds(device.activeFormat.minExposureDuration), min(currentSeconds, 1.0 / 30.0))
+    let targetISO = min(max(device.iso, device.activeFormat.minISO), min(device.activeFormat.maxISO, 640))
+    // Daylight exposures already below both limits need no device-mode switch.
+    guard currentSeconds > targetSeconds + 0.0001 || device.iso > targetISO + 0.5 else { return nil }
+    return await withCheckedContinuation { continuation in
+      do {
+        try device.lockForConfiguration()
+        device.setExposureModeCustom(
+          duration: CMTime(seconds: targetSeconds, preferredTimescale: 60000),
+          iso: targetISO
+        ) { _ in continuation.resume(returning: device) }
+        device.unlockForConfiguration()
+      } catch {
+        continuation.resume(returning: nil)
+      }
+    }
+  }
+
+  private func restoreFilmExposure() {
+    guard let device = filmExposureDevice else { return }
+    filmExposureDevice = nil
+    do {
+      try device.lockForConfiguration()
+      defer { device.unlockForConfiguration() }
+      if device.isExposureModeSupported(.continuousAutoExposure) {
+        device.exposureMode = .continuousAutoExposure
+      }
+    } catch {
+      // A camera switch/unmount can invalidate the old device during a shot.
