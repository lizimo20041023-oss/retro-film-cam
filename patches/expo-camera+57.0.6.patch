+  /// dragging the EV slider emits a stream of values and the session manager only needs the
+  /// latest one, so re-applying an unchanged value would just take the device lock for nothing.
+  /// Clamping to the device's supported range happens on the session queue, not here — only
+  /// the active device knows what it supports.
+  var exposureBias: Double? {
+    didSet {
+      sessionQueue.async {
+        self.sessionManager.setExposureBias()
+      }
+    }
+  }
